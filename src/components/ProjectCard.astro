---
import type { Project } from "../data/site";
interface Props { project: Project; }
const { project: p } = Astro.props;
---
<article class="card" data-slug={p.slug}>
  <h3><a href={p.url} rel="noopener">{p.name}</a></h3>
  <p>{p.blurb}</p>
  <slot />
  <div class="meta">
    {p.tags.join(" · ")}{p.stars ? ` · ★${p.stars}` : ""}
    {p.demo && <> · <a href={p.demo} rel="noopener">demo</a></>}
  </div>
</article>

<style>
  .card {
    border: 1px solid var(--line);
    background: var(--panel);
    padding: 14px 16px;
    display: flex;
    flex-direction: column;
    transition: transform 0.7s cubic-bezier(0.6, -0.3, 0.3, 1.3), opacity 0.4s, border-color 0.2s, box-shadow 0.2s;
  }
  .card:hover { border-color: var(--fg); box-shadow: 0 0 18px #2bff6a22; }
  h3 { margin: 0; font-size: 16px; }
  h3 a { color: var(--hi); text-decoration: none; }
  h3 a::before { content: "▸ "; color: var(--dim); }
  p { margin: 6px 0 12px; font-size: 13.5px; opacity: 0.88; flex: 1; }
  .meta { font-size: 12px; color: var(--dim); }
  .meta a { color: var(--dim); }
</style>
