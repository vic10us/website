---
import { prompt, user, host } from "../data/site";
---
<button id="shell-hint" type="button" aria-controls="shell">press <kbd>`</kbd> for a shell</button>

<div id="shell" role="dialog" aria-label="terminal" aria-hidden="true">
  <div class="bar"><span>tty1 · {user}@{host}</span><button type="button" id="shell-close" aria-label="close terminal">esc ×</button></div>
  <div id="scan" aria-hidden="true"></div>
  <div id="out" role="log" aria-live="polite"></div>
  <form id="inrow" autocomplete="off">
    <label for="in">{prompt}&nbsp;</label>
    <input id="in" autocapitalize="off" autocorrect="off" spellcheck="false" enterkeyhint="send" />
  </form>
</div>

<canvas id="rain" aria-hidden="true"></canvas>

<style>
  #shell-hint {
    position: fixed; right: 16px; bottom: 12px; z-index: 6;
    background: none; border: 0; padding: 4px; cursor: pointer;
    font: 11px var(--mono); color: var(--dim); opacity: 0.55;
  }
  #shell-hint:hover { opacity: 1; color: var(--fg); }
  #shell-hint kbd { font: inherit; }
  #shell {
    position: fixed; left: 0; right: 0; bottom: 0; height: 48vh; min-height: 260px; z-index: 20;
    background: rgba(4, 7, 5, 0.97); border-top: 1px solid var(--fg); box-shadow: 0 -10px 40px #000;
    transform: translateY(102%); transition: transform 0.25s ease; display: flex; flex-direction: column;
  }
  #shell.open { transform: none; }
  #shell .bar { display: flex; justify-content: space-between; align-items: center; padding: 3px 14px; font-size: 11px; background: var(--line); color: var(--hi); }
  #shell .bar button { background: none; border: 0; color: var(--hi); font: inherit; cursor: pointer; }
  #scan { height: 3px; position: relative; overflow: hidden; }
  #scan.on::after {
    content: ""; position: absolute; top: 0; width: 18%; height: 100%;
    background: radial-gradient(closest-side, #ff2a2a, #ff2a2a00); box-shadow: 0 0 12px #ff2a2a;
    animation: kitt 0.9s ease-in-out infinite alternate;
  }
  @keyframes kitt { from { left: 0; } to { left: 82%; } }
  #out { flex: 1; overflow-y: auto; padding: 10px 14px; white-space: pre-wrap; font-size: 13.5px; }
  #out :global(.dim) { color: var(--dim); }
  #out :global(.err) { color: var(--err); }
  #out :global(.ok) { color: var(--hi); }
  #inrow { display: flex; padding: 6px 14px 12px; }
  #inrow label { color: var(--dim); white-space: nowrap; }
  #in { flex: 1; min-width: 0; background: transparent; border: 0; outline: 0; color: var(--hi); font: inherit; font-size: 16px; caret-color: var(--fg); }
  #rain { position: fixed; inset: 0; z-index: 40; pointer-events: none; opacity: 0; transition: opacity 0.8s; }
  #rain.on { opacity: 0.92; }
  @media (max-width: 600px) { #shell-hint { opacity: 0.8; } #inrow label { font-size: 12px; } }
</style>
