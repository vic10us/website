---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { Project } from "../data/site";

interface Props {
  project: Project;
  image?: ImageMetadata;
  alt?: string;
  flip?: boolean;
  live?: boolean;
}
const { project: p, image, alt = "", flip = false, live = false } = Astro.props;
const hasMedia = !!image || live;
---
<article class:list={["row", { flip, bare: !hasMedia }]} data-slug={p.slug}>
  <div class="text">
    <h3><a href={p.site ?? p.url} rel="noopener">{p.name}</a></h3>
    <p>{p.blurb}</p>
    <div class="meta">
      {p.tags.join(" · ")}{p.stars ? ` · ★${p.stars}` : ""}
      {p.site && <> · <a href={p.site} rel="noopener">site</a></>}
      {p.closed ? " · closed source" : <> · <a href={p.url} rel="noopener">source</a></>}
      {p.demo && <> · <a href={p.demo} rel="noopener">demo</a></>}
    </div>
  </div>
  {hasMedia && (
    <div class="media">
      {image ? (
        <a class="pop" href={p.demo ?? p.site ?? p.url} rel="noopener" tabindex="-1" aria-hidden="true">
          <Image src={image} alt={alt} widths={[560, 900, 1200]} sizes="(max-width: 760px) 100vw, 560px" />
        </a>
      ) : (
        <div class="stage"><slot /></div>
      )}
    </div>
  )}
</article>

<style>
  .row {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    align-items: center;
    gap: 28px;
    border: 1px solid var(--line);
    background: var(--panel);
    padding: 22px 24px;
    min-height: 220px;
    transition: transform 0.7s cubic-bezier(0.6, -0.3, 0.3, 1.3), opacity 0.4s, border-color 0.2s, box-shadow 0.2s;
  }
  .row:hover { border-color: var(--fg); box-shadow: 0 0 18px #2bff6a22; }
  .row.bare { grid-template-columns: 1fr; min-height: 0; }
  .row.flip .text { order: 2; }
  .row.flip .media { order: 1; }

  h3 { margin: 0; font-size: 18px; }
  h3 a { color: var(--hi); text-decoration: none; }
  h3 a::before { content: "▸ "; color: var(--dim); }
  p { margin: 8px 0 14px; font-size: 14px; opacity: 0.88; }
  .meta { font-size: 12px; color: var(--dim); }
  .meta a { color: var(--dim); }

  .media { perspective: 1100px; position: relative; }
  .stage {
    height: 170px; border: 1px solid var(--line);
    display: flex; align-items: center; justify-content: center;
    background: radial-gradient(80% 90% at 50% 120%, #08200f, #050706);
  }

  /* 3D pop-out: the screenshot leans out past the card edge */
  .pop {
    display: block;
    margin-right: -64px;
    transform-origin: left center;
    transform: rotateY(-24deg) rotateX(4deg) translateZ(0);
    transition: transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1), filter 0.5s;
    filter: drop-shadow(-18px 22px 22px rgba(0, 0, 0, 0.7)) drop-shadow(0 0 1px var(--fg));
  }
  .flip .pop { margin-right: 0; margin-left: -64px; transform-origin: right center; transform: rotateY(24deg) rotateX(4deg); filter: drop-shadow(18px 22px 22px rgba(0, 0, 0, 0.7)) drop-shadow(0 0 1px var(--fg)); }
  .row:hover .pop { transform: rotateY(-8deg) rotateX(1deg) translateX(-10px) scale(1.04); }
  .row.flip:hover .pop { transform: rotateY(8deg) rotateX(1deg) translateX(10px) scale(1.04); }
  .pop :global(img) { display: block; width: 100%; height: auto; border: 1px solid var(--line); border-radius: 4px; }
  .pop::after {
    content: ""; position: absolute; inset: 0; border-radius: 4px; pointer-events: none;
    background: linear-gradient(115deg, rgba(255, 255, 255, 0.12), transparent 40%);
  }

  @media (max-width: 760px) {
    .row, .row.flip { grid-template-columns: 1fr; padding: 16px; }
    .row.flip .text { order: 0; }
    .pop, .flip .pop { margin: 0 -6px 0 0; transform: rotateY(-10deg); transform-origin: left center; }
    .row:hover .pop, .row.flip:hover .pop { transform: rotateY(-4deg); }
  }
</style>
